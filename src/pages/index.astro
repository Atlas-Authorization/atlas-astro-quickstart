---
import { getAuth } from '@atlasauth/astro/server';

const { userId, isSignedIn } = getAuth(Astro);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>atlas-astro-quickstart</title>
  </head>
  <body style="max-width: 560px; margin: 4rem auto; font-family: system-ui, sans-serif;">
    <h1>atlas-astro-quickstart</h1>
    <p>A starter Astro app wired up with Atlas auth (server-side).</p>

    {isSignedIn ? (
      <>
        <p>Signed in as <code>{userId}</code>.</p>
        <p><a href="/dashboard">Go to your dashboard</a></p>
        <p><a href="/sign-in">Switch account</a></p>
      </>
    ) : (
      <p>You are signed out. <a href="/sign-in">Sign in</a> to continue.</p>
    )}
  </body>
</html>
