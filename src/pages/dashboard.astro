---
import { getAuth } from '@atlasauth/astro/server';

// Defense in depth: the page re-checks the verified session and redirects a
// signed-out visitor to sign-in rather than rendering anything.
const { userId, orgId } = getAuth(Astro);
if (!userId) {
  return Astro.redirect('/sign-in');
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dashboard</title>
  </head>
  <body style="max-width: 560px; margin: 4rem auto; font-family: system-ui, sans-serif;">
    <h1>Dashboard</h1>
    <p>This page is only reachable when you are signed in.</p>
    <p>Your user id is <code>{userId}</code>{orgId ? <> (org <code>{orgId}</code>)</> : null}.</p>
    <p><a href="/">Home</a></p>
  </body>
</html>
